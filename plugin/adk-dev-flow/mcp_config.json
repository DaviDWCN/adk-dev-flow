{
  "mcpServers": {
    "adk-dev-flow": {
      "command": "pythonw",
      "args": [
        "-m",
        "adk_dev_flow.mcp_server"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "REPO_ROOT": ".",
        "ADK_LINT_CMD": "skip",
        "ADK_WORKER_TIMEOUT": "600",
        "ADK_WORKER_MAX_TURNS": "100"
      }
    }
  }
}
